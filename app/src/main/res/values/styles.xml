<resources>
    <style name="DefaultTheme" parent="Theme.AppCompat">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="OverlayText">
        <item name="android:alpha">1</item>
        <item name="android:fontFamily">sans-serif-thin</item>
        <item name="android:textColor">#fff</item>
        <item name="android:textSize">18sp</item>
        <!-- Soft shadow local to the text keeps it legible on bright pictures without a full-width shade. -->
        <item name="android:shadowColor">#E6000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">8</item>
    </style>

    <style name="LoadingText">
        <item name="android:alpha">1</item>
        <item name="android:fontFamily">sans-serif-thin</item>
        <item name="android:textColor">#fff</item>
        <item name="android:textSize">18sp</item>
        <item name="android:shadowColor">#000</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">1</item>
    </style>
</resources>
